---
import '@/styles/global.css';
// First-paint fonts (hero headline roman + italic, navbar mono): preloaded so they arrive with the CSS, not after it.
import newsreader from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import newsreaderItalic from '@fontsource-variable/newsreader/files/newsreader-latin-wght-italic.woff2?url';
import robotoMono from '@fontsource-variable/roboto-mono/files/roboto-mono-latin-wght-normal.woff2?url';
const { title = 'Rebirth Web Design | High-performance websites in Bundaberg' } = Astro.props;
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Fast, secure, static-first websites built in Bundaberg on a production-grade architecture." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {[newsreader, newsreaderItalic, robotoMono].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
