---
// Testimonials slot — replica of useorigin.com `section.testimonial-section`.
// The client has NO testimonials: the 9 blocks are FAQ / foundation cards from docs/COPY.md §10.
// Gold mono label sits where the 5-star row sits (same gold #DDC511, same 23px row height),
// statement where the quote sits, muted question/footer line where the reviewer name sits.
// Reference (measured 2026-11-16 at 1680px, dpr 2):
//  - section padding 45px 32px; wrapper max-width 1400 centred; grid 3 x 1fr, gap 24, rows auto (row-aligned, not masonry)
//  - item padding 48, no background/border; stars 24w x 23h, quote Inter 300 16/135% -0.01em mt24 mb12, name 16/24 rgba(255,255,255,.32)
//  - entrance (Webflow IX2, per item, once): opacity 0 -> 1, translateY 100px -> 0, ~1s ease-out-quart,
//    starts when the item's layout top reaches the viewport bottom; items in one row start together (no stagger)
//  - <=991: 2 cols · <=767: gap 12, item padding 24 · <=479: 1 col, section 24px 16px, item 16, star 20w, quote mt 20
const cards = [
  { label: 'Why Rebirth', text: 'Fast, modern static websites built with Astro and Tailwind CSS — standout design, blazing speed, and 90+ Lighthouse scores.', foot: 'Why choose Rebirth for my project?' },
  { label: 'After launch', text: 'Yes. I can hand off the full source code, or provide ongoing support — updates, new sections, performance tweaks.', foot: 'Do you offer maintenance or updates after launch?' },
  { label: 'Security', text: "Most website hacks happen through databases and plugins. Your site doesn't use either, so far less can be broken into.", foot: 'A minimal attack surface by design' },
  { label: 'Timeline', text: 'A focused prototype can be ready in just a few days. Full custom sites take 2–4 weeks.', foot: 'How long does it take to build a website?' },
  { label: 'Projects', text: 'High-quality static sites: portfolios, business landing pages, marketing sites, documentation hubs, and personal brands. Light dynamic features — forms, search, simple APIs — when they add real value.', foot: 'What kinds of projects do you take on?' },
  { label: 'Pricing', text: 'Pricing is custom and transparent based on your needs. Paid projects start in the mid-four-figure range for bespoke, high-performance sites. A limited number of pro-bono or heavily discounted sites are offered each year. You get a detailed quote after our initial discussion.', foot: 'How much does a website cost?' },
  { label: 'Getting started', text: "Clear goals, any existing branding and assets (logo, colours, photos), content or a plan for it, and reference sites you love. If you're not sure about any of that, I can guide you through discovery and help shape the direction. Every site is mobile-first, accessible, SEO-ready, and tailored to your vision.", foot: 'What do you need from me to get started?' },
  { label: 'Edge-delivered', text: "Your site is distributed across Cloudflare's network and served from the node closest to each visitor. Local customers get instant loads; you're also fast for anyone, anywhere, with no origin server to fall over.", foot: 'Edge-delivered, globally' },
  { label: 'Direct line', text: 'Architecture decisions, changes, and fixes come from one Bundaberg-based developer who knows your entire stack — not an account manager, not an offshore team.', foot: 'Direct line to the developer' },
];
---
<section data-section="Testimonials" class="rbt" aria-label="Common questions">
  <div class="rbt-wrap">
    <div class="rbt-grid">
      {cards.map((c) => (
        <div class="rbt-cell" data-rbt-cell>
          <div class="rbt-item" data-rbt-item>
            <p class="rbt-label">{c.label}</p>
            <p class="rbt-text">{c.text}</p>
            <p class="rbt-foot">{c.foot}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .rbt { padding: 45px 32px; color: #fff; }
  .rbt-wrap { position: relative; z-index: 1; max-width: 1400px; margin: 0 auto; overflow: hidden; }
  .rbt-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; grid-template-rows: auto; gap: 24px; }
  .rbt-item { padding: 48px; }
  .rbt-label {
    margin: 0; height: 23px; display: flex; align-items: center;
    font-family: var(--font-mono); font-size: 12px; line-height: 23px; font-weight: 500;
    letter-spacing: 0.25px; text-transform: uppercase; color: #ddc511; white-space: nowrap;
  }
  .rbt-text {
    margin: 24px 0 12px; font-family: var(--font-sans); font-size: 16px; font-weight: 300;
    line-height: 135%; letter-spacing: -0.01em; color: #fff;
  }
  .rbt-foot { margin: 0; font-family: var(--font-sans); font-size: 16px; line-height: 24px; font-weight: 400; color: rgba(255, 255, 255, 0.32); }

  @media (max-width: 991px) {
    .rbt-wrap { overflow: visible; }
    .rbt-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 767px) {
    .rbt-grid { gap: 12px; }
    .rbt-item { padding: 24px; }
  }
  @media (max-width: 479px) {
    .rbt { padding: 24px 16px; }
    .rbt-grid { grid-template-columns: 1fr; }
    .rbt-item { padding: 16px; }
    /* ref: star row 20w -> 19px tall */
    .rbt-label { height: 19px; line-height: 19px; }
    .rbt-text { margin-top: 20px; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    // The untransformed grid cell is the trigger, the inner block moves: the trigger point is the
    // cell's layout top reaching the viewport bottom, exactly like the reference.
    document.querySelectorAll<HTMLElement>('[data-rbt-cell]').forEach((cell) => {
      const item = cell.querySelector<HTMLElement>('[data-rbt-item]');
      if (!item) return;
      gsap.set(item, { opacity: 0, y: 100 });
      ScrollTrigger.create({
        trigger: cell,
        start: 'top bottom',
        once: true,
        onEnter: () => gsap.to(item, { opacity: 1, y: 0, duration: 1, ease: 'power3.out', overwrite: true }),
      });
    });
  }
</script>
