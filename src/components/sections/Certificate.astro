---
// Certificate — replica of useorigin.com `section.certificate-section`
// Card (rgba(255,255,255,.04), r24, 96/32 padding) + centred serif heading + muted sub + 4 laurel badges
// + two blurred, slowly drifting gradient layers along the bottom edge (meshGradient, 24s alternate).
// Entrance (ref = Webflow IX2): content container fades/slides from opacity 0 / y 100 → 1 / 0,
// 1s outQuart, once, when the container's top reaches the viewport bottom.
import Laurel from './certificate/Laurel.astro';

const badges = [
  // w = reference badge width (px) so the row keeps the same geometry
  { value: '2-3', caption: ['Build days'], w: 195 },
  { value: '<2s', caption: ['Load speed'], w: 176 },
  { value: '100%', caption: ['Client', 'satisfaction'], w: 163 },
  { value: '39k+', caption: ['Astro users'], w: 170 },
];
---
<section data-section="Certificate" class="cert-section mt-4 px-8 max-[479px]:px-4">
  <div class="cert-card relative mx-auto max-w-[1400px] overflow-hidden rounded-[24px] bg-white/[0.04] px-8 py-24 max-[991px]:py-[86px] max-[767px]:py-[76px] max-[479px]:px-4 max-[479px]:py-[66px]">
    <div class="cert-glow cert-glow-1" aria-hidden="true"></div>
    <div class="cert-glow cert-glow-2" aria-hidden="true"></div>

    <div class="cert-trigger relative z-[2] mx-auto max-w-[1200px]">
      <div class="cert-reveal">
        <div class="mx-auto max-w-[634px] text-center">
          <h2 class="cert-heading mb-[24.6px] font-display text-[50px] leading-[55.2px] font-[400] tracking-[-0.012em] text-[rgb(250,250,250)] max-[991px]:text-[39.5px] max-[991px]:leading-[43.7px]">
            Websites in Bundaberg <br class="max-[479px]:hidden" />just got an <em class="italic">upgrade</em>.
          </h2>
          <p class="cert-sub mx-auto max-w-[420px] font-sans text-[16px] leading-[24px] font-[300] text-white/60">
            Hosting, backups, security, and updates — managed for you, every month.
          </p>
        </div>

        <ul class="cert-list mx-auto mt-12 flex flex-wrap items-center justify-center gap-6 max-[991px]:gap-4 max-[767px]:max-w-[475px] max-[479px]:mt-8 max-[479px]:max-w-[390px]" role="list">
          {badges.map((b) => (
            <li class="cert-badge flex h-[75px] items-center justify-between px-[6px] text-[#e6e6e6]" style={`--w:${b.w}px;--k1:${Math.min(1, 148 / b.w).toFixed(4)};--k2:${Math.min(1, 120 / b.w).toFixed(4)}`}>
              <Laurel class="cert-laurel h-[70px] w-auto shrink-0 text-[#d6d6d6]" />
              <div class="flex flex-col items-center text-center">
                <span class="cert-value font-display text-[23px] leading-none font-[450] tracking-[-0.01em]">{b.value}</span>
                <span class="cert-cap mt-[9px] font-mono text-[10px] leading-[13px] font-[500] tracking-[0.07em] uppercase">
                  {b.caption.map((c, i) => <>{i > 0 && <br />}{c}</>)}
                </span>
              </div>
              <Laurel flip class="cert-laurel h-[70px] w-auto shrink-0 text-[#d6d6d6]" />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* Ref badges are images (max-width 148px ≤991, 120px ≤479, scaled proportionally) → zoom the whole badge. */
  .cert-badge { width: var(--w); }
  @media (max-width: 991px) { .cert-badge { zoom: var(--k1); } }
  @media (max-width: 479px) { .cert-badge { zoom: var(--k2); } }

  /* Glow layers: exact reference geometry (early_access_hero-bg / certificate_hero-bg) */
  .cert-glow {
    position: absolute; left: 0; width: 100%; pointer-events: none; z-index: 0;
    background-image: linear-gradient(90deg, rgb(4, 31, 51), rgb(11, 56, 89) 15%, rgb(23, 110, 171) 30%, rgb(255, 255, 255) 51%, rgb(117, 201, 212) 65%, rgb(132, 125, 255) 85%);
    background-position: 50% center; background-size: 150% 150%;
    transform: scale(1.15);
    animation: cert-mesh 24s ease-in-out 0s infinite alternate none running;
  }
  .cert-glow-1 { filter: blur(110px); height: 318px; top: calc(100% - 30px); }
  .cert-glow-2 { z-index: 1; filter: blur(43px); height: 216px; top: calc(100% + 22px); }
  @media (max-width: 767px) { .cert-glow-1 { top: calc(100% - 70px); } }

  @keyframes cert-mesh {
    0% { background-position: 0% 50%; transform: scale(1.15) translate3d(-20px, -10px, 0); }
    25% { background-position: 35% 40%; transform: scale(1.18) translate3d(20px, -20px, 0); }
    50% { background-position: 70% 55%; transform: scale(1.16) translate3d(30px, 10px, 0); }
    75% { background-position: 100% 40%; transform: scale(1.2) translate3d(-15px, 20px, 0); }
    100% { background-position: 0% 60%; transform: scale(1.15) translate3d(-20px, -10px, 0); }
  }
  @media (prefers-reduced-motion: reduce) { .cert-glow { animation: none; } }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-section="Certificate"]').forEach((section) => {
    const trigger = section.querySelector<HTMLElement>('.cert-trigger');
    const reveal = section.querySelector<HTMLElement>('.cert-reveal');
    if (!trigger || !reveal || reduce) return;
    // Ref: opacity 0 / translateY(100px) → 1 / 0, 1000ms Webflow outQuart (= power3.out), plays once.
    const tween = gsap.fromTo(reveal, { opacity: 0, y: 100 }, { opacity: 1, y: 0, duration: 1, ease: 'power3.out', paused: true });
    ScrollTrigger.create({ trigger, start: 'top bottom-=10', once: true, onEnter: () => tween.play() });
  });
</script>
