---
// SpaceArt — the dog-in-space picture (frozen frame from act 2): <SpaceBackdrop/> (no moon) + <Dog/> centred.
// Agent A's components are resolved lazily, so this renders with simple stand-ins until they exist.
interface Props { class?: string; dog?: boolean; [k: string]: any }
const { class: cls = '', dog = true, ...rest } = Astro.props;
const dogMods = import.meta.glob('../../space/Dog.astro', { eager: true }) as Record<string, any>;
const bgMods = import.meta.glob('../../space/SpaceBackdrop.astro', { eager: true }) as Record<string, any>;
const Dog = Object.values(dogMods)[0]?.default ?? null;
const SpaceBackdrop = Object.values(bgMods)[0]?.default ?? null;
---
<div class:list={['psa', cls]} {...rest}>
  {SpaceBackdrop ? <SpaceBackdrop /> : (
    <div class="psa-standin-bg" aria-hidden="true"></div>
  )}
  {dog && (
    <div class="psa-dog" data-ps-dogbox>
      {Dog ? <Dog class="psa-dog-inner" /> : (
        <div class="psa-standin-dog" data-dog aria-hidden="true">
          <div class="rb-gradient-field psa-standin-dog-fill"></div>
        </div>
      )}
    </div>
  )}
</div>

<style>
  .psa { position: absolute; inset: 0; overflow: hidden; background: #03040a; }
  .psa-dog { position: absolute; left: 50%; top: 50%; width: var(--psa-dog-w, 38%); transform: translate(-50%, -50%); }
  .psa-dog :global([data-dog]) { position: relative; width: 100%; }
  /* stand-ins (replaced automatically when src/components/space/{Dog,SpaceBackdrop}.astro exist) */
  .psa-standin-bg { position: absolute; inset: 0;
    background:
      radial-gradient(1px 1px at 12% 18%, #fff 50%, transparent 51%), radial-gradient(1px 1px at 72% 12%, #fff 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 38% 64%, #fff 50%, transparent 51%), radial-gradient(1px 1px at 86% 72%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 22% 84%, #fff 50%, transparent 51%), radial-gradient(1.5px 1.5px at 60% 36%, #cfd6ff 50%, transparent 51%),
      radial-gradient(120% 80% at 70% 20%, #121634 0%, #05060d 60%, #020206 100%); }
  .psa-standin-dog { aspect-ratio: 1 / 0.8; }
  .psa-standin-dog-fill { position: absolute; inset: 0;
    -webkit-mask: radial-gradient(circle at 70% 30%, #000 22%, transparent 23%), radial-gradient(ellipse 45% 32% at 42% 58%, #000 98%, transparent 100%);
            mask: radial-gradient(circle at 70% 30%, #000 22%, transparent 23%), radial-gradient(ellipse 45% 32% at 42% 58%, #000 98%, transparent 100%); }
</style>
