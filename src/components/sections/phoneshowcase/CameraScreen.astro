---
// CameraScreen — generic camera app with face filters (no real brand). Own vector portrait.
// Filters cycle: Stardust (sparkles) -> Bunny (ears + nose) -> Dusk (colour wash) -> Shades (glasses).
// Static state = Stardust active (also the loop's start/end state).
import Icon from './Icon.astro';
const filters = [
  { key: 'stardust', label: 'Stardust', bg: 'linear-gradient(135deg,#f9a8d4,#a855f7)' },
  { key: 'bunny', label: 'Bunny', bg: 'linear-gradient(135deg,#fde68a,#fb7185)' },
  { key: 'dusk', label: 'Dusk', bg: 'linear-gradient(135deg,#f472b6,#2563eb)' },
  { key: 'shades', label: 'Shades', bg: 'linear-gradient(135deg,#67e8f9,#6366f1)' },
];
// chip strip: three copies so neighbours exist on both sides at every step; the loop runs over the middle copy
const chips = [...filters, ...filters, ...filters];
const sparkles = [
  [26, 52, 1.1], [74, 48, 1.4], [20, 92, 0.8], [80, 96, 1], [33, 34, 0.7], [66, 30, 0.9], [50, 22, 0.6],
];
---
<div class="cm" data-ps-camera>
  <svg class="cm-view" viewBox="0 0 100 218" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id="cm-bg" x1="0" y1="0" x2="0.4" y2="1"><stop offset="0" stop-color="#1c1542" /><stop offset="0.55" stop-color="#110d27" /><stop offset="1" stop-color="#07060f" /></linearGradient>
      <radialGradient id="cm-glow" cx="0.5" cy="0.5" r="0.5"><stop offset="0" stop-color="#a855f7" stop-opacity=".45" /><stop offset="1" stop-color="#a855f7" stop-opacity="0" /></radialGradient>
      <linearGradient id="cm-skin" x1="0.2" y1="0" x2="0.8" y2="1"><stop offset="0" stop-color="#f0c3a8" /><stop offset="1" stop-color="#d49a7e" /></linearGradient>
      <linearGradient id="cm-top" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#3b2f7a" /><stop offset="1" stop-color="#1b1640" /></linearGradient>
      <linearGradient id="cm-lens" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#3b82f6" /><stop offset="0.55" stop-color="#7c3aed" /><stop offset="1" stop-color="#ec4899" /></linearGradient>
      <clipPath id="cm-lens-clip"><rect x="30.5" y="72.5" width="16" height="10" rx="4" /><rect x="53.5" y="72.5" width="16" height="10" rx="4" /></clipPath>
    </defs>
    <rect width="100" height="218" fill="url(#cm-bg)" />
    <g class="cm-bokeh" data-cm-bokeh>
      <circle cx="12" cy="40" r="9" fill="#f472b6" opacity=".10" /><circle cx="88" cy="58" r="12" fill="#60a5fa" opacity=".09" />
      <circle cx="84" cy="140" r="7" fill="#c084fc" opacity=".12" /><circle cx="10" cy="150" r="10" fill="#818cf8" opacity=".08" />
    </g>
    <ellipse cx="50" cy="84" rx="44" ry="50" fill="url(#cm-glow)" />
    <g class="cm-person" data-cm-person>
      <!-- shoulders / top -->
      <path d="M6 218 C8 152 24 132 50 129 C76 132 92 152 94 218 Z" fill="url(#cm-top)" />
      <path d="M39 130 Q50 143 61 130" fill="none" stroke="#5b4bb0" stroke-width="1.2" opacity=".7" />
      <!-- neck -->
      <path d="M42.5 104 h15 v24 q-7.5 8 -15 0 z" fill="#c98b70" />
      <!-- head -->
      <ellipse cx="50" cy="82" rx="20" ry="25" fill="url(#cm-skin)" />
      <ellipse cx="30.5" cy="85" rx="3" ry="5" fill="#d49a7e" /><ellipse cx="69.5" cy="85" rx="3" ry="5" fill="#d49a7e" />
      <!-- hair -->
      <path d="M29 84 C26 58 38 50 51 50 C66 50 76 60 71 84 C70 72 64 64 57 62 C51 68 40 70 31 70 C30 75 29.5 79 29 84 Z" fill="#20163f" />
      <path d="M29 84 C27 96 28 106 32 112 C30 100 30 92 31 86 Z" fill="#20163f" />
      <path d="M71 84 C73 96 72 106 68 112 C70 100 70 92 69 86 Z" fill="#20163f" />
      <!-- face -->
      <g fill="none" stroke="#3a2340" stroke-width="1.1" stroke-linecap="round">
        <path d="M35.5 71.5 q4 -2 8 -.4" /><path d="M56.5 71.1 q4 -1.6 8 .4" />
        <path d="M50 79 q-1.6 6 -.8 8.2 q1.2 .6 2.4 0" stroke-width=".9" opacity=".6" />
        <path d="M43.5 95 q6.5 5 13 0" />
      </g>
      <g fill="#2a1a33"><ellipse cx="39.5" cy="77.6" rx="1.6" ry="1.9" /><ellipse cx="60.5" cy="77.6" rx="1.6" ry="1.9" /></g>
      <g fill="#fb7185" opacity=".28"><ellipse cx="36" cy="88" rx="4.4" ry="2.4" /><ellipse cx="64" cy="88" rx="4.4" ry="2.4" /></g>

      <!-- FX: bunny -->
      <g class="cm-fx" data-cm-fx="bunny" opacity="0">
        <g class="cm-ear" data-cm-ear="l">
          <path d="M42 57 C34 46 30 24 36 18 C42 14 47 34 47 55 Z" fill="#f5f0ff" /><path d="M42 53 C37 44 35 28 38 23 C42 22 44.5 36 44.5 52 Z" fill="#f9a8d4" />
        </g>
        <g class="cm-ear" data-cm-ear="r">
          <path d="M58 57 C66 46 70 24 64 18 C58 14 53 34 53 55 Z" fill="#f5f0ff" /><path d="M58 53 C63 44 65 28 62 23 C58 22 55.5 36 55.5 52 Z" fill="#f9a8d4" />
        </g>
        <path d="M47.6 85.6 h4.8 l-2.4 3 z" fill="#f472b6" />
        <g stroke="#fff" stroke-width=".6" stroke-linecap="round" opacity=".85"><path d="M42 88 l-10 -1.6M42 90 l-10 1.2M58 88 l10 -1.6M58 90 l10 1.2" /></g>
      </g>
      <!-- FX: shades -->
      <g class="cm-fx" data-cm-fx="shades" opacity="0">
        <rect x="30.5" y="72.5" width="16" height="10" rx="4" fill="url(#cm-lens)" /><rect x="53.5" y="72.5" width="16" height="10" rx="4" fill="url(#cm-lens)" />
        <path d="M46.5 76.5 q3.5 -2.2 7 0" fill="none" stroke="#111" stroke-width="1.4" />
        <path d="M30.5 75 l-1.6 -1M69.5 75 l1.6 -1" stroke="#111" stroke-width="1.4" />
        <g clip-path="url(#cm-lens-clip)"><rect class="cm-glint" data-cm-glint x="20" y="66" width="3.2" height="24" fill="#fff" opacity=".55" transform="rotate(24 40 78)" /></g>
      </g>
    </g>
    <!-- FX: stardust -->
    <g class="cm-fx" data-cm-fx="stardust">
      {sparkles.map(([x, y, s]) => (
        <g transform={`translate(${x} ${y}) scale(${s})`}><path class="cm-spark" data-cm-spark d="M0 -4 Q.6 -.6 4 0 Q.6 .6 0 4 Q-.6 .6 -4 0 Q-.6 -.6 0 -4Z" fill="#fff" /></g>
      ))}
    </g>
    <!-- face tracking brackets -->
    <g class="cm-track" data-cm-track fill="none" stroke="#fff" stroke-width=".7" stroke-linecap="round" opacity=".7">
      <path d="M24 56 v-6 h6M76 56 v-6 h-6M24 110 v6 h6M76 110 v6 h-6" />
    </g>
  </svg>
  <div class="cm-wash" data-cm-fx="dusk"></div>

  <div class="cm-top">
    <span class="cm-av"></span>
    <span class="cm-pill"><Icon name="search" class="cm-ic" /></span>
  </div>
  <div class="cm-rail">
    <Icon name="flip" class="cm-ic" /><Icon name="flash" class="cm-ic" /><Icon name="timer" class="cm-ic" /><Icon name="music" class="cm-ic" />
  </div>

  <div class="cm-label"><span class="cm-label-in" data-cm-labels>{filters.map((f) => <span data-cm-label={f.key}>{f.label}</span>)}</span></div>
  <div class="cm-carousel">
    <div class="cm-strip" data-cm-strip>
      {chips.map((f) => (
        <span class="cm-chip" style={`background:${f.bg}`}>
          {f.key === 'stardust' && <svg viewBox="0 0 24 24"><path d="M12 4.5Q13 11 19.5 12Q13 13 12 19.5Q11 13 4.5 12Q11 11 12 4.5Z" fill="#fff" /></svg>}
          {f.key === 'bunny' && <svg viewBox="0 0 24 24"><path d="M9 14C7 10 7 5 8.6 4.4 10.2 4 10.8 9 10.8 13.6M15 14c2-4 2-9 .4-9.6-1.6-.4-2.2 4.6-2.2 9.2" fill="#fff" /><circle cx="12" cy="16" r="4" fill="#fff" /></svg>}
          {f.key === 'dusk' && <svg viewBox="0 0 24 24"><path d="M15.5 5.2a7.5 7.5 0 1 0 3.3 11.6 6 6 0 1 1-3.3-11.6z" fill="#fff" /></svg>}
          {f.key === 'shades' && <svg viewBox="0 0 24 24"><rect x="3.5" y="9" width="7" height="5" rx="2" fill="#fff" /><rect x="13.5" y="9" width="7" height="5" rx="2" fill="#fff" /><path d="M10.5 11h3" stroke="#fff" stroke-width="1.4" /></svg>}
        </span>
      ))}
    </div>
    <span class="cm-ring" data-cm-ring></span>
  </div>
</div>

<style>
  .cm { position: absolute; inset: 0; overflow: hidden; background: #07060f; color: #fff; font-family: var(--font-sans); }
  .cm-view { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .cm-wash { position: absolute; inset: 0; opacity: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(236,72,153,.38) 0%, rgba(139,92,246,.22) 45%, rgba(37,99,235,.42) 100%); }
  .cm-top { position: absolute; left: 0; right: 0; top: 12cqw; display: flex; justify-content: space-between; align-items: center; padding: 0 5cqw; }
  .cm-av { width: 8.6cqw; height: 8.6cqw; border-radius: 50%; background: radial-gradient(circle at 40% 35%, #fde68a, #f472b6 55%, #7c3aed); box-shadow: 0 0 0 .6cqw rgba(255,255,255,.18); }
  .cm-pill { width: 8.6cqw; height: 8.6cqw; border-radius: 50%; background: rgba(0,0,0,.28); display: grid; place-items: center; }
  .cm :global(.cm-ic) { width: 5.2cqw; height: 5.2cqw; fill: none; stroke: #fff; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .cm-rail { position: absolute; right: 4.4cqw; top: 26cqw; display: flex; flex-direction: column; gap: 4.4cqw; padding: 2.6cqw 1.8cqw; border-radius: 99px; background: rgba(0,0,0,.22); }
  .cm-label { position: absolute; left: 0; right: 0; top: 158cqw; display: flex; justify-content: center; }
  .cm-label-in { position: relative; height: 6.6cqw; width: 26cqw; border-radius: 99px; background: rgba(0,0,0,.35); overflow: hidden; }
  .cm-label-in span { position: absolute; inset: 0; display: grid; place-items: center; font-size: 3.1cqw; font-weight: 500; letter-spacing: .01em; opacity: 0; transform: translateY(100%); }
  .cm-label-in span:first-child { opacity: 1; transform: none; }
  .cm-carousel { position: absolute; left: 0; right: 0; top: 170cqw; height: 22cqw; }
  /* chip pitch 17cqw, chip 12.5cqw; the strip's chip #4 (first chip of the middle copy) sits under the ring at rest */
  /* strip width = 12 x 17cqw (padding-right closes the last gap) so one step = 100/12 % of its width (xPercent) */
  .cm-strip { position: absolute; top: 4.75cqw; left: calc(50cqw - 6.25cqw - 4 * 17cqw); display: flex; gap: 4.5cqw; padding-right: 4.5cqw; }
  .cm-chip { width: 12.5cqw; height: 12.5cqw; border-radius: 50%; flex: none; display: grid; place-items: center; box-shadow: inset 0 0 0 .5cqw rgba(255,255,255,.25); }
  .cm-chip svg { width: 58%; height: 58%; }
  .cm-ring { position: absolute; left: 50%; top: 50%; width: 20cqw; height: 20cqw; margin: -10cqw 0 0 -10cqw; border-radius: 50%; border: 1.3cqw solid #fff; box-shadow: 0 0 2.4cqw rgba(255,255,255,.25); }
</style>
