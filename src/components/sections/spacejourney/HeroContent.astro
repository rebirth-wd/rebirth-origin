---
// Hero content for the SpaceJourney stage (copied from Hero.astro, namespaced `sj-`).
// H1, subhead, GET STARTED, and the phone with its 3.5s card stack. Background art lives in SpaceJourney.
const cards = [
  { caption: 'AI ASSISTANT', title: 'Trained on your business.', body: 'A chatbot that knows your services, pricing, suburbs and FAQs — and answers after hours.' },
  { caption: 'MAINTENANCE', title: 'Your site repairs itself.', body: 'Security scanning and patching, uptime alerts, and backups that run without anyone remembering to.' },
  { caption: 'PERFORMANCE', title: 'Fixes applied, not reported.', body: "Your codebase is audited against Google's own metrics. We send you the score after we've fixed it." },
  { caption: 'LEAD CAPTURE', title: "See who's ready to buy.", body: 'Every enquiry gets read, summarised and scored before it hits your inbox, with a reply drafted.' },
];
---
<div class="sjh-wrap relative mx-auto flex h-full w-full flex-col items-center justify-start overflow-hidden px-8 pt-[132px]
            max-[767px]:px-[50px] max-[767px]:pt-[124px] max-[479px]:px-4 max-[479px]:pt-[104px]">
  <div class="sjh-container relative mx-auto max-w-[1200px]" data-sjh-container>
    <div class="mx-auto max-w-[830px] text-center">
      <h1 class="relative top-[8px] mt-0 mb-6 font-display text-[96px] leading-[1.15] font-[360] tracking-[-0.005em] text-white
                 max-[991px]:text-[84px] max-[767px]:text-[50px] max-[479px]:mb-4 max-[479px]:text-[34px] max-[479px]:top-[3px]">
        Websites <em class="italic">engineered</em><br />for the modern web.
      </h1>
      <div class="mx-auto mb-6 max-w-[420px] max-[767px]:mb-4">
        <p class="m-0 font-sans text-base leading-6 font-[300] text-white/70">Rebirth builds fast, secure, static-first websites on a production-grade architecture.</p>
      </div>
      <div>
        <a href="/contact" class="sjh-btn inline-flex gap-1 rounded-lg bg-white px-[18px] py-3 font-mono text-xs leading-6 font-medium tracking-[0.25px] text-black uppercase no-underline">
          <span>Get Started</span>
          <svg class="w-[15px] h-6 shrink-0" viewBox="0 0 15 24" fill="none" aria-hidden="true"><path d="M2.5 12h9.5M8 7.75 12.25 12 8 16.25" stroke="currentColor" stroke-width="1.25" stroke-linecap="square"/></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="sjh-phone relative mx-auto mt-12 w-full max-w-[630px] max-[991px]:max-w-[560px] max-[479px]:mt-[38px]" data-sjh-phone>
    <div class="sjh-phone-frame" aria-hidden="true">
      <span class="sjh-btn-side sjh-btn-l1"></span><span class="sjh-btn-side sjh-btn-l2"></span><span class="sjh-btn-side sjh-btn-l3"></span><span class="sjh-btn-side sjh-btn-r1"></span>
      <div class="sjh-phone-screen"></div>
      <div class="sjh-phone-body"><span class="sjh-phone-slot"></span></div>
    </div>
    <div class="relative px-[60px] py-20 max-[991px]:py-[70px] max-[767px]:p-[50px] max-[479px]:px-[30px] max-[479px]:py-10">
      <div class="sjh-icon mx-auto flex aspect-square w-12 items-center justify-center rounded-xl bg-white/8 max-[479px]:w-11">
        <svg class="w-[42%]" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3.5l1.9 4.6 4.6 1.9-4.6 1.9L12 16.5l-1.9-4.6L5.5 10l4.6-1.9L12 3.5z" stroke="#fff" stroke-width="1.3" stroke-linejoin="round"/><path d="M18 15.5l.8 1.7 1.7.8-1.7.8-.8 1.7-.8-1.7-1.7-.8 1.7-.8.8-1.7z" stroke="#fff" stroke-width="1.1" stroke-linejoin="round"/></svg>
      </div>
      <h2 class="relative top-[3px] mt-4 mb-10 tracking-[-0.01em] text-center font-display text-[48px] leading-[1.15] font-[360] text-[#fafafa]
                 max-[991px]:text-[38px] max-[479px]:mb-[30px] max-[479px]:text-[30px]" data-sjh-words>Your site answers, fixes and updates itself</h2>
      <div class="flex w-full items-start justify-center">
        <div class="w-full max-w-[484px] pr-[18px] max-[991px]:pr-0">
          <div class="relative mx-auto h-[248px] max-w-full max-[767px]:h-[250px] max-[479px]:h-[248px]" data-sjh-slider>
            {cards.map((c, i) => (
              <div class={`sjh-card sjh-card-${i} absolute inset-0 flex h-full w-full flex-col items-start gap-6 overflow-hidden rounded-3xl border border-white/8 p-6
                           max-[767px]:gap-[14px] max-[767px]:p-5 max-[479px]:p-4`} data-sjh-card>
                <div class="relative z-[1] font-mono text-[15px] leading-[1.6] font-medium tracking-[2.4px] text-white/32 max-[767px]:text-xs">{c.caption}</div>
                <h3 class="relative top-[3px] z-[1] m-0 tracking-[-0.01em] text-left font-display text-[36px] leading-[1.15] font-[360] text-white/80 max-[767px]:text-[30px]">{c.title}</h3>
                <p class="relative z-[1] m-0 font-sans text-[20px] leading-[1.42] font-[300] tracking-[-0.01em] text-white max-[767px]:text-base max-[479px]:text-sm">{c.body}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .sjh-btn { transition: background-color .2s; }
  .sjh-btn:hover { background-color: rgba(255,255,255,.86); }
  .sjh-icon { box-shadow: 1px 1px 0 0 rgba(255,255,255,.2), inset 1px 1px 0 0 rgba(255,255,255,.3); }
  .sjh-phone { container-type: inline-size; }
  .sjh-phone-frame { position: absolute; inset: 0 0 auto 0; height: calc(100cqw * 1301 / 630); pointer-events: none; filter: drop-shadow(0 30px 40px rgba(0,0,0,.12)); }
  .sjh-phone-body {
    --u: calc(100cqw / 630);
    position: absolute; left: calc(var(--u) * 4.5); right: calc(var(--u) * 4.5); top: 0; bottom: 0;
    border-radius: calc(var(--u) * 116);
    background: #262422;
    box-shadow: inset 0 0 0 calc(var(--u) * 1.5) #454950, inset 0 0 0 calc(var(--u) * 4.5) #a7a7ab, inset 0 0 0 calc(var(--u) * 6.5) #626266;
    -webkit-mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
            mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
    padding: calc(var(--u) * 21);
  }
  /* the stage sits on space + moon (not the old blue sky), so the screen gets a dark glass fill for legibility */
  .sjh-phone-screen { --u: calc(100cqw / 630); position: absolute; left: calc(var(--u) * 25); right: calc(var(--u) * 25); top: calc(var(--u) * 21); bottom: 0; border-radius: calc(var(--u) * 96); background: linear-gradient(180deg, rgba(10,10,22,.86), rgba(6,6,14,.94)); }
  .sjh-phone-body::after { content: ''; position: absolute; inset: calc(var(--u) * 11); border-radius: calc(var(--u) * 105); border: calc(var(--u) * 10) solid #050505; }
  .sjh-phone-slot { position: absolute; top: 0; left: 50%; width: calc(var(--u) * 120); height: calc(var(--u) * 5); transform: translateX(-50%); background: #1a1a1b; border-radius: 0 0 4px 4px; z-index: 1; }
  .sjh-btn-side { position: absolute; width: calc(100cqw * 6 / 630); border-radius: 2px; background: linear-gradient(90deg, #444 0%, #6c6c70 50%, #3a3a3c 100%); }
  .sjh-btn-l1, .sjh-btn-l2, .sjh-btn-l3 { left: 0; }
  .sjh-btn-l1 { top: calc(100cqw * 268 / 630); height: calc(100cqw * 57 / 630); }
  .sjh-btn-l2 { top: calc(100cqw * 371 / 630); height: calc(100cqw * 96 / 630); }
  .sjh-btn-l3 { top: calc(100cqw * 495 / 630); height: calc(100cqw * 95 / 630); }
  .sjh-btn-r1 { right: 0; top: calc(100cqw * 403 / 630); height: calc(100cqw * 157 / 630); }
  .sjh-card {
    z-index: 0;
    background-color: rgba(255,255,255,.04);
    background-image: radial-gradient(100% 58.12% at 100% 100%, rgba(132,125,255,.12) 0%, rgba(132,125,255,0) 100%);
    -webkit-backdrop-filter: blur(24px); backdrop-filter: blur(24px);
  }
  .sjh-card-0 { opacity: 1; z-index: 3; }
  .sjh-card-1 { opacity: .4; z-index: 2; transform: translate(8px, 0) rotate(3deg); }
  .sjh-card-2 { opacity: .4; z-index: 1; transform: translate(3px, 0) rotate(-3deg); }
  .sjh-card-3 { opacity: 0; z-index: 0; }
  /* phones: the copy moves down a little and the hero phone is scaled, leaving the top-left band and the
     bottom-right corner free for the two floating figures */
  @media (max-width: 767px) {
    .sjh-wrap { padding-top: 176px; }
    .sjh-phone { transform: scale(.74); transform-origin: 50% 0; margin-top: 26px; }
  }
  /* load-in initial states (JS + motion only) */
  :global(html.sj-motion) [data-sjh-container] { opacity: 0; transform: translateY(30px); }
  :global(html.sj-motion) [data-sjh-phone] { opacity: 0; }
  :global(html.sj-motion) [data-sjh-words] { visibility: hidden; }
</style>
