---
// Section 2 of the journey: heading + sub line + four stat cards, centred on the moving gradient.
// Each `[data-sj-s2-item]` fades in one after another (driven by the SpaceJourney master timeline: heading, sub line,
// cards 1–4 = beats s2Heading, s2Sub, s2Badge1–4). Each card is dark glass with a looping motion graphic on top
// (../section2cards/*, run by ../section2cards/controller.ts) and the stat below. Markup + CSS are the finished
// static state (what no-JS / reduced-motion visitors see).
import BuildDays from '../section2cards/BuildDays.astro';
import LoadSpeed from '../section2cards/LoadSpeed.astro';
import Satisfaction from '../section2cards/Satisfaction.astro';
import AstroUsers from '../section2cards/AstroUsers.astro';

const cards = [
  { key: 'builddays', value: '2-3', caption: 'Build days', G: BuildDays },
  { key: 'loadspeed', value: '<2s', caption: 'Load speed', G: LoadSpeed },
  { key: 'satisfaction', value: '100%', caption: 'Client satisfaction', G: Satisfaction },
  { key: 'astrousers', value: '39k+', caption: 'Astro users', G: AstroUsers },
];
---
<div class="sj2 mx-auto w-full max-w-[1200px] px-8 max-[479px]:px-4" data-s2cards>
  <div class="mx-auto max-w-[680px] text-center">
    <h2 class="sj2-heading mb-[24.6px] font-display text-[56px] leading-[1.1] font-[400] tracking-[-0.012em] text-white
               max-[991px]:text-[44px] max-[479px]:mb-4 max-[479px]:text-[34px]" data-sj-s2-item>
      Websites in Bundaberg <br class="max-[479px]:hidden" />just got an <em class="italic">upgrade</em>.
    </h2>
    <p class="sj2-sub mx-auto max-w-[420px] font-sans text-[17px] leading-[26px] font-[350] text-white/85 max-[479px]:text-[15px] max-[479px]:leading-[22px]" data-sj-s2-item>
      Hosting, backups, security, and updates — managed for you, every month.
    </p>
  </div>
  <ul class="sj2-list" role="list">
    {cards.map(({ key, value, caption, G }) => (
      <li class="sj2-card" data-sj-s2-item>
        <div class="sj2-graphic" data-s2c-graphic={key} aria-hidden="true"><G /></div>
        <p class="sj2-stat">
          <span class="sj2-value font-display">{value}</span>
          <span class="sj2-caption font-mono">{caption}</span>
        </p>
      </li>
    ))}
  </ul>
</div>

<style>
  .sj2-heading, .sj2-sub { text-shadow: 0 1px 24px rgba(40, 10, 80, .28); }
  .sj2-list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; margin: 48px 0 0; padding: 0; list-style: none; }
  /* dark glass on the live gradient: same family as the site's cards (near-black, 1px low-alpha white border, 20px radius) */
  .sj2-card {
    position: relative; overflow: hidden; border-radius: 20px; color: #fff;
    background: linear-gradient(180deg, rgba(24, 18, 40, .80) 0%, rgba(7, 6, 15, .90) 62%);
    border: 1px solid rgba(255, 255, 255, .10);
    box-shadow: 0 24px 60px -18px rgba(32, 8, 70, .55), inset 0 1px 0 rgba(255, 255, 255, .06);
    -webkit-backdrop-filter: blur(14px) saturate(1.25); backdrop-filter: blur(14px) saturate(1.25);
  }
  /* the graphic: every card's art is one SVG with viewBox 0 0 264 150 that fills this box */
  .sj2-graphic { position: relative; aspect-ratio: 264 / 150; width: 100%; }
  .sj2-graphic > :global(svg) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; overflow: hidden; }
  .sj2-stat { display: flex; align-items: baseline; gap: 10px; margin: 0; padding: 4px 22px 22px; }
  .sj2-value { font-size: 30px; line-height: 1; font-weight: 420; letter-spacing: -0.01em; color: #fafafa; }
  .sj2-caption { font-size: 10px; line-height: 13px; font-weight: 500; letter-spacing: .07em; text-transform: uppercase; color: rgba(255, 255, 255, .55); }

  @media (max-width: 991px) {
    .sj2-list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; max-width: 560px; margin: 32px auto 0; }
    /* keep the 2 × 2 block inside one screen: the art gets shorter as the viewport does */
    .sj2-graphic { aspect-ratio: auto; height: clamp(84px, calc((100vh - 470px) / 2), 150px); }
    @supports (height: 100svh) { .sj2-graphic { height: clamp(84px, calc((100svh - 470px) / 2), 150px); } }
    .sj2-stat { padding: 2px 16px 16px; gap: 8px; }
    .sj2-value { font-size: 24px; }
  }
  @media (max-width: 479px) {
    .sj2-list { gap: 10px; margin-top: 22px; }
    .sj2-graphic { height: clamp(70px, calc((100vh - 470px) / 2), 120px); }
    @supports (height: 100svh) { .sj2-graphic { height: clamp(70px, calc((100svh - 470px) / 2), 120px); } }
    .sj2-stat { flex-direction: column; align-items: flex-start; gap: 5px; padding: 0 12px 12px; }
    .sj2-value { font-size: 22px; }
    .sj2-caption { font-size: 9px; line-height: 12px; }
  }
</style>
