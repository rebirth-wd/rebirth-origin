---
// PartnerHero — replica of useorigin.com `section.partner-hero`.
// Measured on the reference (1680x904 viewport):
//  section padding 96px 32px → card max-width 1400, min-height 80vh, radius 24, overflow hidden,
//  padding 50px 100px 50px, content centred both ways. Media = looping video (here: still photo, cover).
//  Video treatment: three stacked backdrop-blur layers (8/12/24px) masked to the lower part of the card
//  (progressive blur toward the bottom) + a flat rgba(0,0,0,.3) overlay. The card itself does not animate
//  (no scale / clip / radius / parallax).
//  Entrance: Webflow "scroll into view" on `.container` (the centred content block): opacity 0→1 and
//  y 100px→0, 1000ms outQuart (= GSAP power3.out), 250ms delay, fires once when the (translated) block
//  enters the viewport, never replays. No SplitText on this heading.
//  Button: dark translucent pill (white/.1 → white/.18 on hover, 200ms) inside a "glowing wrapper" whose
//  rotating conic light ring (2.5s linear, always on) + faint blurred glow are permanently active here.
//  The "This isn't a button, it's magic" second label is display:none on the reference, so it never shows.
import { images } from '@/data/images';
import Badge from './partnerhero/Badge.astro';

const img = images.daisies;
---
<script is:inline>document.documentElement.classList.add('ph-js');</script>
<section data-section="PartnerHero" class="ph-section relative px-8 py-24 max-[991px]:py-[86px] max-[767px]:py-[76px] max-[479px]:px-4 max-[479px]:py-[66px]">
  <div class="ph-card relative z-10 mx-auto flex min-h-[80vh] w-full max-w-[1400px] items-center justify-center overflow-hidden rounded-3xl px-[100px] pt-[50px] pb-[50px]
              max-[991px]:px-[5%] max-[767px]:px-[50px] max-[767px]:pt-[70px] max-[767px]:pb-[70px] max-[479px]:px-6"
       style={`background-color:${img.avg}`}>
    <img class="ph-media pointer-events-none absolute inset-0 z-[1] h-full w-full object-cover"
         src={img.src} srcset={`${img.srcSmall} 900w, ${img.src} 2000w`} sizes="(max-width: 1464px) 100vw, 1400px"
         alt="" loading="lazy" decoding="async" onerror="this.style.visibility='hidden'" />
    <div class="ph-blur ph-blur-1" aria-hidden="true"></div>
    <div class="ph-blur ph-blur-2" aria-hidden="true"></div>
    <div class="ph-blur ph-blur-3" aria-hidden="true"></div>

    <div class="ph-reveal relative z-[2] mx-auto max-w-[1200px]">
      <div class="mx-auto flex max-w-[980px] flex-col items-center justify-start gap-6 text-center max-[767px]:gap-5 max-[479px]:mt-4">
        <div class="flex items-start justify-center">
          <Badge />
        </div>
        <h2 class="ph-heading m-0 font-display text-white">A direct line to the<br /><em class="italic">developer</em>.</h2>
        <p class="m-0 mx-auto max-w-[420px] font-sans text-base leading-6 font-normal text-white">You work with the person writing the code — not an account manager, not an offshore team.</p>
        <div class="ph-glow relative inline-block overflow-hidden rounded-lg">
          <a href="/about" class="ph-btn inline-flex gap-1 rounded-lg bg-white/10 px-[18px] py-3 font-mono text-xs leading-6 font-medium text-white uppercase no-underline transition-[background-color] duration-200 hover:bg-white/[.18]">
            <span>How we work</span>
          </a>
          <span class="ph-glow-anim" aria-hidden="true"><span class="ph-glow-glow"></span></span>
          <span class="ph-glow-ring" aria-hidden="true"><span class="ph-glow-borders"></span></span>
        </div>
        <p class="m-0 font-sans text-xs leading-[1.8] font-normal tracking-[-0.01em] text-white/80 max-[479px]:text-[10px]">One Bundaberg-based developer</p>
      </div>
    </div>

    <div class="pointer-events-none absolute inset-0 z-[1] bg-black/30" aria-hidden="true"></div>
  </div>
</section>

<style>
  /* Newsreader stand-in for Lyon Display 300 @ 80px / 1em (same tuning as the other display headings) */
  .ph-heading { position: relative; top: .1em; font-size: 76px; line-height: 80px; letter-spacing: -0.015em; font-weight: 370; font-variation-settings: 'opsz' 72; }
  .ph-heading em { font-weight: 370; }
  @media (max-width: 991px) { .ph-heading { font-size: 66.5px; line-height: 70px; } }
  @media (max-width: 767px) { .ph-heading { font-size: 52.25px; line-height: 55px; } }
  @media (max-width: 479px) { .ph-heading { font-size: 43.7px; line-height: 46px; } }

  /* progressive blur over the lower part of the media (ref .hero-bg-layer x3) */
  .ph-blur { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  .ph-blur-1 { -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    -webkit-mask-image: linear-gradient(rgba(0,0,0,0) 20%, #000 30%); mask-image: linear-gradient(rgba(0,0,0,0) 20%, #000 30%); }
  .ph-blur-2 { -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    -webkit-mask-image: linear-gradient(rgba(0,0,0,0) 35%, #000 65%); mask-image: linear-gradient(rgba(0,0,0,0) 35%, #000 65%); }
  .ph-blur-3 { -webkit-backdrop-filter: blur(24px); backdrop-filter: blur(24px);
    -webkit-mask-image: linear-gradient(rgba(0,0,0,0) 50%, #000 80%); mask-image: linear-gradient(rgba(0,0,0,0) 50%, #000 80%); }

  /* "magic" button wrapper: rotating conic light seen through a ~1px ring + faint blurred glow (ref .glowing-wrapper-active) */
  .ph-glow-anim, .ph-glow-borders { position: absolute; top: 50%; left: 50%; width: 110%; transform: translate(-50%, -50%); pointer-events: none; }
  .ph-glow-anim::before, .ph-glow-borders::before { content: ''; float: left; padding-top: 100%; }
  .ph-glow-glow { position: absolute; inset: 0; opacity: .12; filter: blur(8px); }
  .ph-glow-glow, .ph-glow-borders {
    background-image: conic-gradient(rgba(255,255,255,.5) 0deg, rgba(255,255,255,0) 60deg, rgba(255,255,255,0) 310deg, rgba(255,255,255,.5) 360deg);
    background-position: center; background-repeat: no-repeat; background-size: cover;
  }
  .ph-glow-glow { animation: ph-turn 2.5s linear infinite; }
  .ph-glow-borders { animation: ph-turn-t 2.5s linear infinite; }
  .ph-glow-ring {
    position: absolute; inset: 0; border-radius: 8px; padding: .06rem; pointer-events: none;
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); -webkit-mask-composite: xor;
    mask: linear-gradient(#fff 0 0) content-box exclude, linear-gradient(#fff 0 0);
  }
  @keyframes ph-turn { to { transform: rotate(360deg); } }
  @keyframes ph-turn-t { from { transform: translate(-50%, -50%) rotate(0deg); } to { transform: translate(-50%, -50%) rotate(360deg); } }

  /* entrance initial state only when JS runs */
  :global(html.ph-js) .ph-reveal { opacity: 0; transform: translate3d(0, 100px, 0); }
  @media (prefers-reduced-motion: reduce) {
    :global(html.ph-js) .ph-reveal { opacity: 1; transform: none; }
    .ph-glow-glow, .ph-glow-borders { animation: none; }
  }
</style>

<script>
  import gsap from 'gsap';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-section="PartnerHero"]').forEach((section) => {
    const el = section.querySelector<HTMLElement>('.ph-reveal');
    if (!el || reduce) return;
    // Webflow scroll-into-view (offset 0%): fires once when the translated block's box enters the viewport.
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        gsap.fromTo(el, { opacity: 0, y: 100 }, { opacity: 1, y: 0, duration: 1, delay: 0.25, ease: 'power3.out' });
      });
    });
    io.observe(el);
  });
</script>
