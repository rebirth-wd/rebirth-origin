---
// AstroUsers — section-2 stat card art: a rising growth line with a rolling counter chip that lands on "39k+".
// Static markup = the finished state (line fully drawn, end dot top-right, chip reads 39k+). Loop: astroUsers.ts.
// Only transform / opacity / stroke-dashoffset ever change. The end dot is a zero-length round-capped dash on a copy
// of the line, so moving its dashoffset slides it along the curve in perfect step with the draw.
const P: [number, number][] = [[20, 121], [50, 113], [82, 117], [114, 98], [146, 101], [178, 75], [210, 61], [240, 30]];
let d = `M${P[0][0]} ${P[0][1]}`;
for (let i = 0; i < P.length - 1; i++) {
  const p0 = P[i - 1] ?? P[i], p1 = P[i], p2 = P[i + 1], p3 = P[i + 2] ?? p2;
  const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
  const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
  d += ` C${c1[0].toFixed(2)} ${c1[1].toFixed(2)} ${c2[0].toFixed(2)} ${c2[1].toFixed(2)} ${p2[0]} ${p2[1]}`;
}
const END = P[P.length - 1];
const BASE = 136;
const area = `${d} L${END[0]} ${BASE} L${P[0][0]} ${BASE} Z`;
const GRID = [40, 72, 104, BASE];

// Counter: two digit strips under a clipPath; "k+" is fixed. STEP = strip row height (keep in sync with astroUsers.ts).
const STEP = 24, BASELINE = 41;
const TENS = [0, 1, 2, 3];
const UNITS = [...Array(20).keys()].map((n) => n % 10); // 0-9 twice, ends on 9
const COLS = [{ x: 59, strip: TENS }, { x: 69.6, strip: UNITS }];
---
<svg viewBox="0 0 264 150" preserveAspectRatio="xMidYMid meet" data-s2c-art="astrousers" class="astrousers">
  <defs>
    <linearGradient id="astrousers-stroke" gradientUnits="userSpaceOnUse" x1="20" y1="0" x2="240" y2="0">
      <stop offset="0" stop-color="#ff4fa3" /><stop offset=".5" stop-color="#a855f7" /><stop offset="1" stop-color="#60a5fa" />
    </linearGradient>
    <linearGradient id="astrousers-area" gradientUnits="userSpaceOnUse" x1="0" y1="30" x2="0" y2={BASE}>
      <stop offset="0" stop-color="#8b5cf6" stop-opacity=".42" /><stop offset=".55" stop-color="#a855f7" stop-opacity=".14" /><stop offset="1" stop-color="#f472b6" stop-opacity="0" />
    </linearGradient>
    <clipPath id="astrousers-clip"><rect x="52" y="25" width="24" height="19.5" /></clipPath>
  </defs>

  <g stroke="rgba(255,255,255,.11)" stroke-width="1">{GRID.map((y) => <path d={`M20 ${y} H244`} />)}</g>

  <g data-au-fx>
    <path d={area} fill="url(#astrousers-area)" data-au-area />
    <path d={d} pathLength="1000" fill="none" stroke="url(#astrousers-stroke)" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="1000 3000" stroke-dashoffset="0" opacity=".2" data-au-line />
    <path d={d} pathLength="1000" fill="none" stroke="url(#astrousers-stroke)" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="1000 3000" stroke-dashoffset="0" data-au-line />

    <circle cx={END[0]} cy={END[1]} r="6" fill="none" stroke="#93c5fd" stroke-width="1.4" opacity="0" data-au-ring />
    <g data-au-dotwrap>
      <path d={d} pathLength="1000" fill="none" stroke="#60a5fa" stroke-width="17" stroke-linecap="round" stroke-dasharray="0 2000" stroke-dashoffset="-999" opacity=".16" data-au-dot />
      <path d={d} pathLength="1000" fill="none" stroke="#60a5fa" stroke-width="10.5" stroke-linecap="round" stroke-dasharray="0 2000" stroke-dashoffset="-999" opacity=".38" data-au-dot />
      <path d={d} pathLength="1000" fill="none" stroke="#fff" stroke-width="5.2" stroke-linecap="round" stroke-dasharray="0 2000" stroke-dashoffset="-999" data-au-dot />
    </g>

    <g data-au-chip>
      <rect x="20" y="17" width="94" height="36" rx="18" fill="#141126" stroke="rgba(255,255,255,.16)" stroke-width="1" />
      <rect x="20.5" y="17.5" width="93" height="35" rx="17.5" fill="rgba(255,255,255,.05)" />
      <circle cx="38" cy="35" r="9.5" fill="rgba(46,189,107,.18)" />
      <path d="M34.2 38.8 L41.6 31.4 M36.4 31.2 H41.8 V36.6" fill="none" stroke="#2ebd6b" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" />
      <g clip-path="url(#astrousers-clip)">
        {COLS.map((c) => (
          <g data-au-digit transform={`translate(0 ${-(c.strip.length - 1) * STEP})`}>
            {c.strip.map((n, i) => <text class="astrousers-num" x={c.x} y={BASELINE + i * STEP} text-anchor="middle">{n}</text>)}
          </g>
        ))}
      </g>
      <text class="astrousers-num" x="75.6" y={BASELINE}>k+</text>
    </g>
  </g>
</svg>

<style>
  .astrousers { overflow: visible; }
  .astrousers-num { font-family: var(--font-display); font-size: 20px; font-weight: 420; font-variant-numeric: lining-nums tabular-nums; fill: rgba(255,255,255,.92); }
</style>
