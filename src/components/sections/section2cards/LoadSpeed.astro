---
// LoadSpeed — "<2s load speed" card art. A wireframe page assembles block by block while a load bar fills along a
// track and stops clearly short of the "2s" tick; a green check confirms. Markup = the finished state.
// The loop lives in ./loadSpeed.ts (transform / opacity only).
const TRACK_X = 40, TRACK_W = 184, BAR_Y = 112, BAR_H = 5;
const FILL_W = 92;                 // the bar stops here (x = 132) ...
const TICK_X = 194;                // ... well before the 2s tick
const END_X = TRACK_X + FILL_W;
const MID_Y = BAR_Y + BAR_H / 2;
---
<svg viewBox="0 0 264 150" preserveAspectRatio="xMidYMid meet" data-s2c-art="loadspeed">
  <defs>
    <linearGradient id="loadspeed-hero" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ff4fa3" stop-opacity=".62" />
      <stop offset=".55" stop-color="#8b5cf6" stop-opacity=".55" />
      <stop offset="1" stop-color="#3b82f6" stop-opacity=".5" />
    </linearGradient>
    <linearGradient id="loadspeed-btn" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#f472b6" /><stop offset="1" stop-color="#a855f7" />
    </linearGradient>
    <linearGradient id="loadspeed-fill" gradientUnits="userSpaceOnUse" x1={TRACK_X} y1="0" x2={END_X} y2="0">
      <stop offset="0" stop-color="#60a5fa" /><stop offset=".55" stop-color="#a78bfa" /><stop offset="1" stop-color="#f472b6" />
    </linearGradient>
    <linearGradient id="loadspeed-frame" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity=".09" /><stop offset="1" stop-color="#fff" stop-opacity=".03" />
    </linearGradient>
    <radialGradient id="loadspeed-glow" cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#8b5cf6" stop-opacity=".30" /><stop offset="1" stop-color="#8b5cf6" stop-opacity="0" />
    </radialGradient>
    <clipPath id="loadspeed-clip"><rect x={TRACK_X} y={BAR_Y} width={TRACK_W} height={BAR_H} rx={BAR_H / 2} /></clipPath>
  </defs>

  <!-- browser window -->
  <g data-ls-page>
    <ellipse cx="132" cy="56" rx="104" ry="52" fill="url(#loadspeed-glow)" data-ls-glow />
    <g data-ls-frame>
      <rect x="54" y="14" width="156" height="80" rx="9" fill="url(#loadspeed-frame)" stroke="rgba(255,255,255,.2)" stroke-width="1" />
      <path d="M54.5 32.5 H209.5" stroke="rgba(255,255,255,.12)" stroke-width="1" />
    </g>
    <circle cx="65" cy="23.5" r="2.4" fill="#f472b6" data-ls-dot />
    <circle cx="73" cy="23.5" r="2.4" fill="#a78bfa" data-ls-dot />
    <circle cx="81" cy="23.5" r="2.4" fill="#60a5fa" data-ls-dot />
    <rect x="64" y="40" width="136" height="24" rx="5" fill="url(#loadspeed-hero)" stroke="rgba(255,255,255,.14)" stroke-width=".75" data-ls-block />
    <rect x="64" y="71" width="84" height="4.5" rx="2.25" fill="rgba(255,255,255,.34)" data-ls-block />
    <rect x="64" y="80" width="58" height="4.5" rx="2.25" fill="rgba(255,255,255,.18)" data-ls-block />
    <rect x="162" y="70" width="38" height="15" rx="7.5" fill="url(#loadspeed-btn)" data-ls-btn />
  </g>

  <!-- load bar: track + 2s tick stay; fill + check are the animated part -->
  <rect x={TRACK_X} y={BAR_Y} width={TRACK_W} height={BAR_H} rx={BAR_H / 2} fill="rgba(255,255,255,.12)" />
  <path d={`M${TICK_X} ${BAR_Y - 6} V${BAR_Y + BAR_H + 6}`} stroke="rgba(255,255,255,.6)" stroke-width="1.5" stroke-linecap="round" />
  <text x={TRACK_X} y="136" class="loadspeed-lbl" text-anchor="start">0</text>
  <text x={TICK_X} y="136" class="loadspeed-lbl loadspeed-lbl--on" text-anchor="middle">2s</text>

  <g data-ls-load>
    <g clip-path="url(#loadspeed-clip)">
      <rect x={TRACK_X} y={BAR_Y} width={FILL_W} height={BAR_H} rx={BAR_H / 2} fill="url(#loadspeed-fill)" data-ls-fill data-ls-w={FILL_W} />
    </g>
    <circle cx={END_X} cy={MID_Y} r="8" fill="none" stroke="#2ebd6b" stroke-width="1.5" opacity="0" data-ls-ring data-ls-cx={END_X} data-ls-cy={MID_Y} />
    <g data-ls-check data-ls-cx={END_X} data-ls-cy={MID_Y}>
      <circle cx={END_X} cy={MID_Y} r="8" fill="#2ebd6b" stroke="rgba(7,6,15,.9)" stroke-width="2" />
      <path d={`M${END_X - 3.4} ${MID_Y + 0.2} l2.4 2.5 l4.5 -5`} fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  </g>
</svg>

<style>
  .loadspeed-lbl { font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: .07em; fill: rgba(255, 255, 255, .45); }
  .loadspeed-lbl--on { fill: rgba(255, 255, 255, .9); }
</style>
