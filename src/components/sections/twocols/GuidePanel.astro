---
// Row 3 infographic (ref: .guide-slider-content — 181×148 five-segment score gauge, a 400px "Summary" glass card
// pulled up 20px over it, then a 400×210 vertically-masked column of 8px-radius action cards; ref scrolls them,
// here a static frame). Gauge geometry: centre (90.5, 90.9), r 86.9, 5 arcs over a 260° sweep, round caps.
const cx = 90.5, cy = 90.9, R = 86.9;
const pt = (deg: number) => {
  const a = (deg * Math.PI) / 180;
  return [cx + R * Math.cos(a), cy - R * Math.sin(a)].map((n) => n.toFixed(2)).join(' ');
};
// angles in standard orientation (0 = right, CCW positive); sweep clockwise from 220° to -40°
const segs = [
  { from: 218, to: 172, c: '#fc4a4a' },
  { from: 164, to: 118, c: '#f28c25' },
  { from: 110, to: 70, c: '#ddc511' },
  { from: 62, to: 16, c: '#049b8f' },
  { from: 8, to: -38, c: '#009c5a' },
];
const arc = (f: number, t: number) => `M ${pt(f)} A ${R} ${R} 0 0 1 ${pt(t)}`;
// marker at 90% of the sweep (220° → -40°)
const mDeg = 220 - 0.9 * 260;
const mr = R + 0, ma = (mDeg * Math.PI) / 180;
const mx = cx + (mr - 8) * Math.cos(ma), my = cy - (mr - 8) * Math.sin(ma);

const actions = [
  {
    cap: 'SECURITY', title: 'Fewer weak points by design',
    body: 'Most website hacks happen through databases and plugins. Your site doesn’t use either, so there’s simply far less that can be broken into. Fewer weak points, fewer things to worry about.',
  },
  {
    cap: 'UPDATES', title: 'Tested before it hits production',
    body: 'Security patches and framework updates are applied deliberately and tested against a preview deploy before they ever hit production. Your site stays modern instead of aging into a liability.',
  },
];
---
<div class="tcg flex max-w-full flex-col items-center justify-start">
  <svg class="tcg-gauge" viewBox="0 0 181 148" width="181" height="148" role="img" aria-label="Lighthouse score 90 plus">
    {segs.map((s, i) => (
      <path d={arc(s.from, s.to)} fill="none" stroke={s.c} stroke-width="6.2" stroke-linecap="round" opacity={i === 4 ? 0.9 : 1} />
    ))}
    <path d={`M ${(mx).toFixed(2)} ${(my - 4.5).toFixed(2)} l 4 7 h -8 z`} fill="#fff" stroke="#121212" stroke-width="1" transform={`rotate(${(90 - mDeg).toFixed(1)} ${mx.toFixed(2)} ${my.toFixed(2)})`} />
    <text x="90.5" y="97" text-anchor="middle" class="tcg-val">90+</text>
  </svg>

  <div class="tcg-summary">
    <span class="tcg-spark" aria-hidden="true">
      <svg viewBox="0 0 12 12" width="12" height="12"><path d="M6 0c.4 3.2 1.8 5.1 6 6-4.2.9-5.6 2.8-6 6-.4-3.2-1.8-5.1-6-6 4.2-.9 5.6-2.8 6-6z" fill="#8a8dff" /></svg>
    </span>
    <div>
      <div class="tcg-title">Summary</div>
      <p class="tcg-desc m-0">Your site stays modern instead of aging into a liability, with updates applied deliberately.</p>
    </div>
  </div>

  <div class="tcg-list">
    <div class="tcg-track">
      {actions.map((a, i) => (
        <div class="tcg-item" aria-hidden={i > 0 ? 'true' : undefined}>
          <div class="tcg-cap-row">
            <svg viewBox="0 0 16 16" width="15" height="15" fill="none" stroke="rgba(255,255,255,.8)" stroke-width="1.3" aria-hidden="true">
              {i === 0
                ? <path d="M8 1.5 2.5 3.7v4c0 3.3 2.3 5.6 5.5 6.8 3.2-1.2 5.5-3.5 5.5-6.8v-4z" />
                : <><path d="M13.5 8A5.5 5.5 0 1 1 11.9 4.1" /><path d="M13.6 1.8v2.8h-2.8" /></>}
            </svg>
            <span class="tcg-cap">{a.cap}</span>
          </div>
          <div class="p-4">
            <div class="tcg-title">{a.title}</div>
            <p class="tcg-desc mt-2 mb-4">{a.body}</p>
            <a href="/ai-tools" class="tcg-btn" tabindex={i > 0 ? -1 : undefined}>See Details</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .tcg-gauge { position: relative; z-index: 0; flex: none; }
  .tcg-val { font-family: var(--font-display); font-size: 37px; font-weight: 300; fill: #fff; letter-spacing: -0.02em; }

  .tcg-summary {
    position: relative; z-index: 1; display: flex; gap: 10px; width: 100%; max-width: 400px; margin-top: -20px; padding: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px;
    background: radial-gradient(173.25% 100% at 50.07% 0%, rgba(252, 74, 74, 0.1) 0%, rgba(252, 74, 74, 0.004) 40%);
    -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
    box-shadow: rgba(138, 0, 0, 0.05) 26px 26px 261px;
  }
  .tcg-spark { display: flex; align-self: flex-start; height: 16px; align-items: center; justify-content: center; width: 16px; aspect-ratio: 1; margin-top: 2px; flex: none; }
  .tcg-title { font-family: var(--font-sans); font-size: 14px; font-weight: 400; line-height: 142%; letter-spacing: -0.01em; color: #fff; }
  .tcg-desc { font-family: var(--font-sans); font-size: 12px; font-weight: 300; line-height: 166%; letter-spacing: -0.01em; color: rgba(255, 255, 255, 0.8); }
  .tcg-summary .tcg-desc { margin-top: 8px; }

  .tcg-list {
    position: relative; width: 100%; max-width: 400px; height: 210px; overflow: hidden;
    -webkit-mask-image: linear-gradient(rgba(7,7,7,0) 0%, #070707 30%, #070707 70%, rgba(7,7,7,0) 100%);
            mask-image: linear-gradient(rgba(7,7,7,0) 0%, #070707 30%, #070707 70%, rgba(7,7,7,0) 100%);
  }
  .tcg-track { position: absolute; left: 0; right: 0; top: -12px; display: flex; flex-direction: column; gap: 16px; }
  .tcg-item {
    border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px;
    background-color: rgb(5, 5, 5);
    background-image: radial-gradient(58.63% 38.68% at 50% 0%, rgba(132, 125, 255, 0.2) 0%, rgba(132, 125, 255, 0.016) 100%);
  }
  .tcg-cap-row { display: flex; align-items: center; gap: 10px; padding: 24px 16px; border: 1px solid rgba(255, 255, 255, 0.04); }
  .tcg-cap { font-family: var(--font-mono); font-size: 10px; font-weight: 500; line-height: 160%; letter-spacing: 1.6px; color: rgba(255, 255, 255, 0.8); }
  .tcg-btn {
    display: block; width: 100%; padding: 10px; border-radius: 8px; text-align: center; text-decoration: none;
    background-color: rgba(255, 255, 255, 0.08); color: #fff;
    font-family: var(--font-sans); font-size: 12px; font-weight: 300; line-height: 100%; letter-spacing: -0.01em;
    transition: background-color 0.3s ease-in-out;
  }
  .tcg-btn:hover { background-color: rgba(255, 255, 255, 0.12); }

  @media (max-width: 991px) {
    .tcg-gauge { width: 150px; height: auto; }
    .tcg-cap-row { padding-top: 16px; padding-bottom: 16px; }
  }
  @media (max-width: 767px) {
    .tcg-gauge { width: 181px; }
    .tcg-list { height: 250px; }
    .tcg-cap-row { padding-top: 24px; padding-bottom: 24px; }
  }
  @media (max-width: 479px) {
    .tcg-cap-row { padding-top: 16px; padding-bottom: 16px; }
  }
</style>
