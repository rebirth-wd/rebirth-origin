---
// Rigged smoke "astronaut" (left = purple/pink with red legs, right = blue).
// Parts are cut from src/assets/space/source-figures.webp by tools in docs/journey/ASSETS.md; layout comes from rig.json.
// Contract: docs/journey/SPEC.md + docs/journey/ASSETS.md.
import rig from './rig.json';
interface Props { who: 'left' | 'right'; class?: string }
const { who, class: cls = '' } = Astro.props;
const R = (rig as any)[who];
const files = import.meta.glob<{ default: { src: string } }>('../../assets/space/astronaut-*.webp', { eager: true });
const url = (f: string) => files[`../../assets/space/${f}`].default.src;
type P = { name: string; parent: string | null; z: number; file: string; css: any };
const parts: P[] = R.parts;
const kids = (name: string | null) => parts.filter((p) => p.parent === name);
// Render the part tree to HTML (nested so children follow their parent's rotation).
const render = (p: P, parentZ: number): string => {
  const c = p.css;
  const style = `left:${c.left}%;top:${c.top}%;width:${c.width}%;height:${c.height}%;transform-origin:${c.ox}% ${c.oy}%;z-index:${p.parent ? p.z - parentZ : 0}`;
  const hand = p.name === 'arm-reach-lower'
    ? `<i data-hand-marker style="left:${R.handInPart[0]}%;top:${R.handInPart[1]}%"></i>` : '';
  return `<div class="rb-astro__part" data-part="${p.name}" style="${style}"><img src="${url(p.file)}" alt="" draggable="false" decoding="async" />${hand}${kids(p.name).map((k) => render(k, p.z)).join('')}</div>`;
};
const html = kids(null).map((p) => render(p, 0)).join('');
const vars = `aspect-ratio:${R.width}/${R.height};--chest-x:${R.chest[0]}%;--chest-y:${R.chest[1]}%;--hand-x:${R.hand[0]}%;--hand-y:${R.hand[1]}%;--head-angle:${R.headAngle}deg;--reach:0`;
---
<div class:list={['rb-astro', cls]} data-astronaut={who} style={vars} role="img" aria-label={who === 'left' ? 'Floating figure made of pink and purple smoke' : 'Floating figure made of blue smoke'}>
  <div class="rb-astro__rig" data-rig set:html={html} />
  <i data-chest-marker style="left:var(--chest-x);top:var(--chest-y)"></i>
</div>

<style is:global>
  .rb-astro { position: relative; width: 100%; height: auto; pointer-events: none; user-select: none; }
  .rb-astro__rig { position: absolute; inset: 0; transform-origin: var(--chest-x) var(--chest-y); }
  .rb-astro__part { position: absolute; }
  .rb-astro__part > img { position: absolute; inset: 0; width: 100%; height: 100%; display: block; max-width: none; }
  .rb-astro [data-hand-marker], .rb-astro [data-chest-marker] { position: absolute; width: 0; height: 0; }
</style>

<script>
  import { initAll } from './astronaut';
  initAll();
</script>
