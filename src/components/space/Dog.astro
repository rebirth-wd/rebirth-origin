---
// Original vector art: a big friendly dog in a round space helmet with an air tank + hose, side view facing right.
// Geometry generated by docs/journey/tools/dog.py -> dog.json. The body is the shared moving gradient
// (.rb-gradient-field) cut out with a vector mask, so it stays crisp at any size; the overlay SVG adds the
// helmet glass, the dog's head inside it, tank bands and rim light so it reads when small.
import dog from './dog.json';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const [vx, vy, vw, vh] = dog.viewBox;
const vb = `${vx} ${vy} ${vw} ${vh}`;
const maskSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="${vb}" preserveAspectRatio="none"><path fill="#000" d="${dog.silhouette}"/></svg>`;
const mask = `url("data:image/svg+xml,${encodeURIComponent(maskSvg)}")`;
const { cx, cy, r } = dog.helmet;
const style = `aspect-ratio:${vw}/${vh};--body-x:${dog.body[0]}%;--body-y:${dog.body[1]}%;--dog-mask:${mask}`;
---
<div class:list={['rb-dog', cls]} data-dog style={style} role="img" aria-label="Silhouette of a large dog wearing a space helmet and an air tank">
  <div class="rb-dog__fill rb-gradient-field"></div>
  <svg class="rb-dog__detail" viewBox={vb} preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <clipPath id="rb-dog-helmet-clip"><circle cx={cx} cy={cy} r={r} /></clipPath>
      <radialGradient id="rb-dog-glass" cx="0.38" cy="0.32" r="0.75">
        <stop offset="0" stop-color="#fff" stop-opacity="0.22" />
        <stop offset="0.55" stop-color="#fff" stop-opacity="0.04" />
        <stop offset="1" stop-color="#0b0620" stop-opacity="0.28" />
      </radialGradient>
    </defs>
    <!-- far legs a touch darker for depth -->
    <path d={dog.farLegs} fill="#140a3a" fill-opacity="0.28" />
    <!-- dog head inside the helmet -->
    <g clip-path="url(#rb-dog-helmet-clip)">
      <path d={dog.head} fill="#1a0d45" fill-opacity="0.42" />
      <path d={dog.ear} fill="#120835" fill-opacity="0.5" />
      <circle cx="958" cy="218" r="9" fill="#0d0628" fill-opacity="0.75" />
      <circle cx="1038" cy="250" r="11" fill="#0d0628" fill-opacity="0.7" />
      <circle cx={cx} cy={cy} r={r} fill="url(#rb-dog-glass)" />
    </g>
    <!-- helmet rim + glass highlights -->
    <circle cx={cx} cy={cy} r={r - 7} fill="none" stroke="#fff" stroke-opacity="0.55" stroke-width="10" />
    <path d={`M ${cx - r * 0.72} ${cy - r * 0.22} A ${r * 0.78} ${r * 0.78} 0 0 1 ${cx - r * 0.12} ${cy - r * 0.74}`} fill="none" stroke="#fff" stroke-opacity="0.75" stroke-width="13" stroke-linecap="round" />
    <path d={`M ${cx + r * 0.52} ${cy + r * 0.48} A ${r * 0.74} ${r * 0.74} 0 0 0 ${cx + r * 0.7} ${cy + r * 0.12}`} fill="none" stroke="#fff" stroke-opacity="0.4" stroke-width="8" stroke-linecap="round" />
    <!-- tank: shading + bands (body itself is kept clean: it fills the screen in act 2) -->
    <path d={dog.tankBody} fill="#fff" fill-opacity="0.1" />
    <path d="M 410 236 L 640 228" stroke="#fff" stroke-opacity="0.45" stroke-width="7" stroke-linecap="round" />
    <path d="M 470 222 L 474 306 M 590 218 L 594 302" stroke="#0d0628" stroke-opacity="0.35" stroke-width="12" />
    <!-- rim light along the silhouette -->
    <path d={dog.silhouette} fill="none" stroke="#fff" stroke-opacity="0.28" stroke-width="5" vector-effect="non-scaling-stroke" />
  </svg>
</div>

<style is:global>
  .rb-dog { position: relative; width: 100%; height: auto; pointer-events: none; }
  .rb-dog__fill, .rb-dog__detail { position: absolute; inset: 0; width: 100%; height: 100%; }
  .rb-dog__fill {
    -webkit-mask-image: var(--dog-mask); mask-image: var(--dog-mask);
    -webkit-mask-size: 100% 100%; mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
  }
  .rb-dog__detail { overflow: visible; opacity: var(--dog-detail, 1); }
</style>
